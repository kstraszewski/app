# Copy this file to .env.local and use the DEV values from your Trigger.dev
# project. The copied file is ignored by git.
TRIGGER_PROJECT_REF=proj_your_project_ref
TRIGGER_SECRET_KEY=tr_dev_your_secret_key

# Durable case-message realtime delivery retry.
OPENEXPERT_MESSAGING_OUTBOX_URL=https://crm.openexpert.example.com/api/internal/messaging/outbox
NUXT_MESSAGING_OUTBOX_SECRET=replace-with-at-least-32-random-characters

# Lease-backed forum vectorization worker (uses the same shared secret).
OPENEXPERT_FORUM_EMBEDDINGS_URL=https://crm.openexpert.example.com/api/internal/forum/embeddings

# Set only for a self-hosted Trigger.dev control plane.
# TRIGGER_API_URL=http://127.0.0.1:8030
