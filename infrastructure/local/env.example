# `pnpm --filter @openexpert/database db:local:setup` creates
# `.env.local-stack` with these local-only values and an Ed25519 keypair.
# The generated file is ignored by git and is chmod 0600.

OPENEXPERT_POSTGRES_DB=openexpert
OPENEXPERT_POSTGRES_PORT=55322
OPENEXPERT_POSTGRES_PASSWORD=openexpert-postgres-local
OPENEXPERT_ADMIN_PASSWORD=openexpert-admin-local
OPENEXPERT_AUTH_PASSWORD=openexpert-auth-local
OPENEXPERT_RUNTIME_PASSWORD=openexpert-runtime-local
OPENEXPERT_AUTHENTICATOR_PASSWORD=openexpert-authenticator-local
DATABASE_URL=postgresql://openexpert_auth:openexpert-auth-local@127.0.0.1:55322/openexpert
NUXT_AUTH_DATABASE_URL=postgresql://openexpert_auth:openexpert-auth-local@127.0.0.1:55322/openexpert
BETTER_AUTH_URL=http://127.0.0.1:3004
BETTER_AUTH_COOKIE_PREFIX=openexpert-local
# Generated once by setup; keep the same value across local apps:
# BETTER_AUTH_SECRET=<random base64url secret>
OPENEXPERT_DEV_EMAIL=admin@openexpert.local
OPENEXPERT_DEV_PASSWORD=OpenExpert123!
OPENEXPERT_DEV_FULL_NAME=Local Administrator
OPENEXPERT_DEV_ORGANIZATION=OpenExpert Local
OPENEXPERT_DEV_ORGANIZATION_SLUG=openexpert-local

OPENEXPERT_POSTGREST_PORT=55321
NUXT_PUBLIC_DATA_API_URL=http://127.0.0.1:55321
NUXT_DATA_API_JWT_AUDIENCE=openexpert-data
NUXT_DATA_API_JWT_ISSUER=openexpert-local

OPENEXPERT_MAILPIT_UI_PORT=55324
OPENEXPERT_MAILPIT_SMTP_PORT=55325
NUXT_SMTP_HOST=127.0.0.1
NUXT_SMTP_PORT=55325

OPENEXPERT_MINIO_API_PORT=55326
OPENEXPERT_MINIO_CONSOLE_PORT=55327
OPENEXPERT_MINIO_ROOT_USER=openexpert
OPENEXPERT_MINIO_ROOT_PASSWORD=openexpert-minio-local-secret
NUXT_STORAGE_PROVIDER=minio
NUXT_MINIO_ENDPOINT=http://127.0.0.1:55326
NUXT_MINIO_REGION=us-east-1
NUXT_MINIO_ACCESS_KEY_ID=openexpert
NUXT_MINIO_SECRET_ACCESS_KEY=openexpert-minio-local-secret
NUXT_MINIO_PUBLIC_BUCKET=openexpert-public
NUXT_MINIO_PRIVATE_BUCKET=openexpert-private
NUXT_MINIO_PUBLIC_BASE_URL=http://127.0.0.1:55326/openexpert-public

# Generated once by setup:
# NUXT_BOOKING_RATE_LIMIT_SECRET=<random base64url secret>

# Optional locally; CEIDG endpoints return 503 until a server-only token is set.
NUXT_CEIDG_API_BASE_URL=https://dane.biznes.gov.pl
# NUXT_CEIDG_API_TOKEN=<Biznes.gov.pl API token>
NUXT_CEIDG_GLOBAL_MINUTE_LIMIT=120
NUXT_CEIDG_GLOBAL_HOURLY_LIMIT=1000

OPENEXPERT_LIVEKIT_HTTP_PORT=7880
OPENEXPERT_LIVEKIT_RTC_TCP_PORT=7881
OPENEXPERT_LIVEKIT_RTC_UDP_PORT=7882
NUXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
NUXT_LIVEKIT_API_KEY=devkey
NUXT_LIVEKIT_API_SECRET=secret

# Generated by setup; never commit real values:
# NUXT_DATA_API_JWT_PRIVATE_KEY=<base64-encoded PKCS8 PEM>
# NUXT_DATA_API_JWT_PUBLIC_JWK=<public JWK JSON>
# NUXT_DATA_API_JWT_KEY_ID=<local key id>
# OPENEXPERT_DATA_API_JWKS=<public JWKS JSON consumed by PostgREST>
