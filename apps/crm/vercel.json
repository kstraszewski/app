{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "nuxtjs",
      "bindings": [
        {
          "type": "service",
          "service": "bank-mail-eve",
          "format": "url",
          "env": "BANK_MAIL_AGENT_INTERNAL_URL"
        }
      ]
    },
    "eve": {
      "root": ".",
      "buildCommand": "eve build",
      "entrypoint": "agent",
      "framework": "eve"
    },
    "bank-mail-eve": {
      "root": "services/bank-mail-agent",
      "buildCommand": "eve build",
      "framework": "eve"
    }
  },
  "rewrites": [
    {
      "source": "/eve/v1/(.*)",
      "destination": {
        "service": "eve"
      }
    },
    {
      "source": "/_eve_internal/eve/(.*)",
      "destination": {
        "service": "eve"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
