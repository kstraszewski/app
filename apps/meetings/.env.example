# Adres projektu z LiveKit Cloud (Project Settings).
NUXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Tylko po stronie serwera. Nigdy nie używaj prefiksu NUXT_PUBLIC_.
NUXT_LIVEKIT_API_KEY=
NUXT_LIVEKIT_API_SECRET=

# Publiczne demo jest ograniczone do jednego pokoju i chronione kodem.
NUXT_MEETINGS_ROOM_NAME=demo-room
NUXT_MEETINGS_ACCESS_CODE=replace-with-a-long-random-passphrase

# Opcjonalnie: jedyna zewnętrzna domena CRM, która może osadzić aplikację.
NUXT_MEETINGS_EMBED_ORIGIN=https://crm.example.com
