{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "BETTER_AUTH_*",
    "DATABASE_URL",
    "NUXT_*",
    "AI_GATEWAY_API_KEY",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "OPENEXPERT_DEV_EMAIL",
    "OPENEXPERT_DEV_PASSWORD",
    "OPENEXPERT_DEV_ORGANIZATION",
    "OPENEXPERT_DEV_ORGANIZATION_SLUG",
    "OPENEXPERT_DEV_FULL_NAME",
    "NUXT_ABLY_API_KEY",
    "NUXT_NOTIFICATIONS_ABLY_API_KEY",
    "NUXT_NOTIFICATIONS_OUTBOX_SECRET",
    "NUXT_MESSAGING_OUTBOX_SECRET",
    "OPENEXPERT_MESSAGING_OUTBOX_URL",
    "OPENEXPERT_NOTIFICATION_OUTBOX_URL",
    "OPENEXPERT_FORUM_EMBEDDINGS_URL"
  ],
  "tasks": {
    "db:reset": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:provision-account": {
      "cache": false
    },
    "db:seed-demo": {
      "cache": false
    },
    "db:setup": {
      "cache": false
    },
    "db:start": {
      "cache": false
    },
    "db:status": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:verify": {
      "cache": false
    },
    "mortgage:sync": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".nuxt/**", ".output/**"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": [".nuxt/**", ".output/public/**"]
    },
    "prepare": {
      "outputs": [".nuxt/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": false
    },
    "trigger:deploy": {
      "cache": false,
      "passThroughEnv": [
        "TRIGGER_ACCESS_TOKEN",
        "TRIGGER_API_URL",
        "TRIGGER_PROJECT_REF",
        "TRIGGER_SECRET_KEY"
      ]
    },
    "trigger:dev": {
      "cache": false,
      "passThroughEnv": [
        "TRIGGER_API_URL",
        "TRIGGER_PROJECT_REF",
        "TRIGGER_SECRET_KEY"
      ],
      "persistent": true
    },
    "trigger:login": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["TRIGGER_API_URL"]
    },
    "dev": {
      "dependsOn": ["prepare"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
