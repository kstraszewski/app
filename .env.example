# Copy these values to apps/crm/.env and apps/landing/.env.
# Running 'pnpm db:setup' generates both local files automatically.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Server-only. Never prefix this value with NUXT_PUBLIC_.
NUXT_SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Set to true only when the CRM is behind a trusted proxy that overwrites X-Forwarded-For.
NUXT_BOOKING_SECURITY_TRUST_PROXY=false
# Optional dedicated HMAC secret; otherwise the Supabase server key is used.
NUXT_BOOKING_SECURITY_RATE_LIMIT_SECRET=

# Server-only calendar OAuth. Generate the encryption key with:
# openssl rand -base64 32
NUXT_CALENDAR_OAUTH_ENCRYPTION_KEY=
NUXT_CALENDAR_OAUTH_GOOGLE_CLIENT_ID=
NUXT_CALENDAR_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_CALENDAR_OAUTH_GOOGLE_REDIRECT_URI=https://crm.example.com/api/calendar/oauth/google/callback
NUXT_CALENDAR_OAUTH_MICROSOFT_CLIENT_ID=
NUXT_CALENDAR_OAUTH_MICROSOFT_CLIENT_SECRET=
NUXT_CALENDAR_OAUTH_MICROSOFT_REDIRECT_URI=https://crm.example.com/api/calendar/oauth/microsoft/callback
# "common" supports personal Outlook.com and Microsoft 365 accounts.
NUXT_CALENDAR_OAUTH_MICROSOFT_TENANT=common

# Server-only Resend configuration for apps/landing.
# Leave the API key empty locally; Supabase Auth emails continue to use Mailpit.
NUXT_RESEND_API_KEY=re_your_api_key
NUXT_RESEND_FROM="OpenExpert <hello@updates.openexpert.app>"
NUXT_RESEND_REPLY_TO=hello@openexpert.app

# Optional local account overrides used by packages/database.
OPENEXPERT_DEV_EMAIL=admin@openexpert.local
OPENEXPERT_DEV_PASSWORD=OpenExpert123!
OPENEXPERT_DEV_ORGANIZATION=OpenExpert Local
OPENEXPERT_DEV_FULL_NAME=Local Administrator
