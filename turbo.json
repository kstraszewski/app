{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".nuxt/**", ".output/**"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": [".nuxt/**", ".output/public/**"]
    },
    "prepare": {
      "outputs": [".nuxt/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
