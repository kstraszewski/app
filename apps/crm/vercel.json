{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": ".",
      "framework": "nuxtjs"
    },
    "eve": {
      "root": ".",
      "buildCommand": "eve build",
      "entrypoint": "agent",
      "framework": "eve"
    }
  },
  "rewrites": [
    {
      "source": "/eve/v1/(.*)",
      "destination": {
        "service": "eve"
      }
    },
    {
      "source": "/_eve_internal/eve/(.*)",
      "destination": {
        "service": "eve"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
