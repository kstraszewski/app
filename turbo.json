{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:reset": {
      "cache": false
    },
    "db:setup": {
      "cache": false
    },
    "db:start": {
      "cache": false
    },
    "db:status": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:types": {
      "cache": false
    },
    "db:verify": {
      "cache": false
    },
    "mortgage:sync": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".nuxt/**", ".output/**"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": [".nuxt/**", ".output/public/**"]
    },
    "prepare": {
      "outputs": [".nuxt/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
