{
  "name": "openexpert",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "db:migrate": "turbo run db:migrate --filter=@openexpert/database",
    "db:provision-account": "turbo run db:provision-account --filter=@openexpert/database",
    "db:provision-production-account": "pnpm --filter @openexpert/database db:provision-production-account",
    "db:reset": "turbo run db:reset --filter=@openexpert/database",
    "db:seed-demo": "turbo run db:seed-demo --filter=@openexpert/database",
    "db:seed-production-showcase": "pnpm --filter @openexpert/database db:seed-production-showcase",
    "db:seed-production-mock-bank": "pnpm --filter @openexpert/database db:seed-production-mock-bank",
    "db:setup": "turbo run db:setup --filter=@openexpert/database",
    "db:start": "turbo run db:start --filter=@openexpert/database",
    "db:status": "turbo run db:status --filter=@openexpert/database",
    "db:stop": "turbo run db:stop --filter=@openexpert/database",
    "db:verify": "turbo run db:verify --filter=@openexpert/database",
    "dev": "turbo run dev",
    "dev:bank-mail-agent": "turbo run dev --filter=@openexpert/crm-bank-mail-agent",
    "dev:landing": "turbo run dev --filter=@openexpert/landing",
    "dev:crm": "node --env-file-if-exists=apps/landing/.env.local --env-file-if-exists=.env.local ./node_modules/turbo/bin/turbo run dev --filter=@openexpert/crm --filter=@openexpert/crm-bank-mail-agent",
    "dev:client": "turbo run dev --filter=@openexpert/client",
    "generate": "turbo run generate",
    "mortgage:sync": "turbo run mortgage:sync --filter=@openexpert/database",
    "preview": "turbo run preview",
    "trigger:deploy": "turbo run trigger:deploy --filter=@openexpert/tasks",
    "trigger:dev": "turbo run trigger:dev --filter=@openexpert/tasks",
    "trigger:login": "turbo run trigger:login --filter=@openexpert/tasks --ui=tui",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "rollup": "4.62.4",
    "turbo": "^2.9.6"
  }
}
