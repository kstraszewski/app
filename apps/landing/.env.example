# Required by the Eve agent mounted at /eve/v1/*.
AI_GATEWAY_API_KEY=

# Canonical public URL used by SEO metadata, robots.txt and sitemap.xml.
NUXT_PUBLIC_SITE_URL=https://www.openexpert.app

# Public CRM origin that hosts the existing booking flow.
NUXT_PUBLIC_CRM_BASE_URL=https://crm.openexpert.app

# Public Mapbox token used by the facility directory and detail pages.
# Restrict production tokens to the deployed OpenExpert origins in Mapbox.
NUXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token
