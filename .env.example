# OpenExpert runtime configuration.
# `pnpm db:setup` generates safe local values in .env.local-stack and syncs
# managed blocks into apps/*/.env. Do not copy production secrets to this file.

# PostgreSQL / Better Auth (server-only)
# In production use the pooled Neon URL for application traffic. Better Auth
# needs a role with access only to identity.users/sessions/accounts/verifications/jwks.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NUXT_AUTH_DATABASE_URL=postgresql://auth_user:password@host/database?sslmode=require
BETTER_AUTH_DATABASE_SCHEMA=identity
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_URL=https://crm.openexpert.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_COOKIE_PREFIX=openexpert
BETTER_AUTH_CLIENT_COOKIE_PREFIX=openexpert-client
# Optional for staff-facing apps that intentionally share a session. Client
# portal uses a separate cookie name and should normally stay host-only.
NUXT_AUTH_COOKIE_DOMAIN=.openexpert.example.com
NUXT_CLIENT_AUTH_COOKIE_DOMAIN=
NUXT_AUTH_TRUSTED_ORIGINS=https://openexpert.example.com,https://crm.openexpert.example.com,https://client.openexpert.example.com
# Optional sign-in methods for already activated identities. Register the
# client portal callback URL in the Google/Apple provider console.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_APPLE_CLIENT_ID=
BETTER_AUTH_APPLE_CLIENT_SECRET=

# Neon Data API in production, native PostgREST locally.
NUXT_PUBLIC_DATA_API_URL=https://your-neon-data-api.example.com
NUXT_DATA_API_URL=https://your-neon-data-api.example.com
NUXT_DATA_API_JWT_AUDIENCE=openexpert-data
NUXT_DATA_API_JWT_ISSUER=https://crm.openexpert.example.com
NUXT_DATA_API_JWT_KEY_ID=openexpert-production-1
# Base64-encoded Ed25519 PKCS8 PEM. Server-only; configure only the derived
# public JWK in Neon Data API/PostgREST.
NUXT_DATA_API_JWT_PRIVATE_KEY=

# Object storage. Production uses two Vercel Blob stores because access is a
# store-level property; local development uses two MinIO buckets.
NUXT_STORAGE_PROVIDER=vercel-blob
NUXT_VERCEL_BLOB_PUBLIC_TOKEN=
NUXT_VERCEL_BLOB_PUBLIC_STORE_ID=
NUXT_VERCEL_BLOB_PUBLIC_BASE_URL=
NUXT_VERCEL_BLOB_PRIVATE_TOKEN=
NUXT_VERCEL_BLOB_PRIVATE_STORE_ID=
# Vercel injects VERCEL_OIDC_TOKEN when OIDC is enabled.
VERCEL_OIDC_TOKEN=

# Local MinIO alternative (generated automatically by pnpm db:setup).
# NUXT_STORAGE_PROVIDER=minio
NUXT_MINIO_ENDPOINT=http://127.0.0.1:55326
NUXT_MINIO_REGION=us-east-1
NUXT_MINIO_ACCESS_KEY_ID=openexpert
NUXT_MINIO_SECRET_ACCESS_KEY=replace-for-non-local-use
NUXT_MINIO_PUBLIC_BUCKET=openexpert-public
NUXT_MINIO_PRIVATE_BUCKET=openexpert-private
NUXT_MINIO_PUBLIC_BASE_URL=http://127.0.0.1:55326/openexpert-public

# Email. Production uses Resend; local setup points SMTP at Mailpit.
NUXT_RESEND_API_KEY=re_your_api_key
NUXT_AUTH_EMAIL_FROM="OpenExpert <no-reply@auth.openexpert.example.com>"
NUXT_AUTH_EMAIL_REPLY_TO=hello@openexpert.example.com
NUXT_RESEND_FROM="OpenExpert <hello@updates.openexpert.example.com>"
NUXT_RESEND_REPLY_TO=hello@openexpert.example.com
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=

# Application URLs and browser-safe integrations.
NUXT_MULTIFORM_SERVICE_URL=https://openexpert.example.com
NUXT_PUBLIC_CRM_BASE_URL=https://crm.openexpert.example.com
NUXT_PUBLIC_LANDING_BASE_URL=https://openexpert.example.com
NUXT_PUBLIC_CLIENT_BASE_URL=https://client.openexpert.example.com
NUXT_CLIENT_PORTAL_BASE_URL=https://client.openexpert.example.com
NUXT_PUBLIC_CLIENT_PORTAL_BASE_URL=https://client.openexpert.example.com
NUXT_CLIENT_PORTAL_INVITATION_TTL_SECONDS=3600
NUXT_PUBLIC_SITE_URL=https://openexpert.example.com
NUXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# Case messaging. The Ably key is server-only: browsers receive short-lived,
# conversation-scoped tokens from authenticated Nuxt endpoints. The outbox
# secret authenticates the Trigger.dev retry task against the CRM drain route.
NUXT_ABLY_API_KEY=your-ably-app.key:secret
# Optional forum-only Ably app; when empty, the shared key above is used.
NUXT_FORUM_ABLY_API_KEY=
NUXT_MESSAGING_OUTBOX_SECRET=replace-with-at-least-32-random-characters
OPENEXPERT_MESSAGING_OUTBOX_URL=https://crm.openexpert.example.com/api/internal/messaging/outbox
OPENEXPERT_FORUM_EMBEDDINGS_URL=https://crm.openexpert.example.com/api/internal/forum/embeddings

# Verified consent capture. Production requires an HTTPS SMS gateway and a
# separate high-entropy HMAC secret. The demo flag permits the local no-op
# provider in a production build and puts OTP in a self-clearing URL fragment;
# never enable it for real clients or production data.
NUXT_CONSENT_SMS_PROVIDER=http
NUXT_CONSENT_SMS_DEMO_AUTO_FILL=false
NUXT_CONSENT_SMS_GATEWAY_URL=https://sms-gateway.example.com/messages
NUXT_CONSENT_SMS_GATEWAY_TOKEN=replace-with-provider-token
NUXT_CONSENT_SMS_SENDER=OpenExpert
NUXT_CONSENT_OTP_SECRET=replace-with-at-least-32-random-characters
NUXT_CONSENT_PUBLIC_BASE_URL=https://crm.openexpert.example.com
NUXT_CONSENT_SMS_TTL_SECONDS=600
NUXT_CONSENT_OTP_MAX_ATTEMPTS=5

# Server-only AI credentials.
AI_GATEWAY_API_KEY=vck_your_ai_gateway_key
GOOGLE_GENERATIVE_AI_API_KEY=

# Trigger.dev background tasks. The project ref is public configuration; the
# remaining values are server-only. TRIGGER_API_URL is only needed when using
# a self-hosted Trigger.dev control plane.
TRIGGER_PROJECT_REF=proj_your_project_ref
TRIGGER_SECRET_KEY=tr_dev_your_secret_key
# TRIGGER_API_URL=http://127.0.0.1:8030

# Booking security.
NUXT_BOOKING_SECURITY_TRUST_PROXY=false
NUXT_BOOKING_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Calendar OAuth (server-only). Generate encryption keys with:
# openssl rand -base64 32
NUXT_CALENDAR_OAUTH_ENCRYPTION_KEY=
NUXT_CALENDAR_OAUTH_GOOGLE_CLIENT_ID=
NUXT_CALENDAR_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_CALENDAR_OAUTH_GOOGLE_REDIRECT_URI=https://crm.openexpert.example.com/api/calendar/oauth/google/callback
NUXT_CALENDAR_OAUTH_MICROSOFT_CLIENT_ID=
NUXT_CALENDAR_OAUTH_MICROSOFT_CLIENT_SECRET=
NUXT_CALENDAR_OAUTH_MICROSOFT_REDIRECT_URI=https://crm.openexpert.example.com/api/calendar/oauth/microsoft/callback
NUXT_CALENDAR_OAUTH_MICROSOFT_TENANT=common

# Gmail OAuth (use a separate Google Cloud project from Calendar).
NUXT_MAIL_OAUTH_ENCRYPTION_KEY=
NUXT_MAIL_OAUTH_GOOGLE_CLIENT_ID=
NUXT_MAIL_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_MAIL_OAUTH_GOOGLE_REDIRECT_URI=https://crm.openexpert.example.com/api/mail/oauth/google/callback

# Local seed overrides.
OPENEXPERT_DEV_EMAIL=admin@openexpert.local
OPENEXPERT_DEV_PASSWORD=OpenExpert123!
OPENEXPERT_DEV_ORGANIZATION=OpenExpert Local
OPENEXPERT_DEV_ORGANIZATION_SLUG=openexpert-local
OPENEXPERT_DEV_FULL_NAME=Local Administrator
