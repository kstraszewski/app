{
  "name": "openexpert",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev --filter=@openexpert/landing",
    "dev:crm": "turbo run dev --filter=@openexpert/crm",
    "generate": "turbo run generate",
    "preview": "turbo run preview",
    "postinstall": "turbo run prepare"
  },
  "devDependencies": {
    "turbo": "^2.9.6"
  }
}
